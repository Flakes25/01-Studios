# Public site + admin login (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only: saves booking inquiries. Never expose this key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional email alert for new inquiries (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
# Optional cookieless analytics (plausible.io)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
